# Copy to .env.local for local development.
# The app falls back to a development-only admin password if this is unset.
ADMIN_PASSWORD=change-me-now

# Use a long random string in production.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Supabase Postgres connection string.
# For Vercel, use the transaction pooler URI (port 6543):
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# For local Postgres over a Unix socket:
# postgresql:///prime_test?host=/var/run/postgresql
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Storage. Create a public bucket named property-images.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-service-role-key
SUPABASE_STORAGE_BUCKET=property-images

# Used for canonical URLs, sitemap and social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
