# Copy to .env.local for local development.
# The app falls back to a development-only password if this is unset.
ADMIN_PASSWORD=change-me-now

# Use a long random string in production.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional. Defaults to ./data/prime.db
DATABASE_PATH=./data/prime.db

# Used for canonical URLs, sitemap and social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
